# Copy to .env and fill in. Never commit .env itself - it is gitignored.
# Every variable below is read at runtime by src/lib or prisma/seed.ts.

# Where the SQLite file lives.
#   Local dev: a relative path is fine, prisma.config.ts resolves it to an absolute
#   path so the Prisma CLI and the running app agree on one file.
#   Deployed:  MUST be absolute (e.g. file:/data/dev.db). A relative path lands in
#   a different place for the CLI than for the server, which silently splits the
#   database in two.
DATABASE_URL="file:./dev.db"

# Bearer token for GET|POST /api/cron/sync. Generate with: openssl rand -hex 32
# If unset the endpoint refuses to run (503) rather than syncing unauthenticated.
CRON_SECRET=""

# Bootstrap admin, created by `npm run db:seed` / `db:setup` when the email does
# not already exist. Minimum 8 characters. Because .env is gitignored, these must
# be set on the host too or no admin gets created and nobody can sign in.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME=""